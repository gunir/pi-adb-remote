{
  "name": "pi-adb-remote",
  "version": "0.1.0",
  "description": "Persistent Android device workspaces for Pi, over ADB.",
  "type": "module",
  "author": "Yutong Bian",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "adb",
    "android",
    "android-debug-bridge",
    "device-workspace"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunir/pi-adb-remote.git"
  },
  "homepage": "https://github.com/gunir/pi-adb-remote#readme",
  "bugs": {
    "url": "https://github.com/gunir/pi-adb-remote/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:live": "PI_ADB_LIVE=1 node --test tests/live/*.live.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
